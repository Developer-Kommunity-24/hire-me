# Copy this file to `.env.local` (gitignored) and fill in real values.
#   cp apps/web/.env.local.example apps/web/.env.local

# Neon Auth base URL 
NEON_AUTH_BASE_URL=https://REPLACE-ME.example.com

# Secret used to sign the session cookie. Must be at least 32 characters.
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Base URL of the Hono API Worker 
NEXT_PUBLIC_API_URL=http://localhost:8787
